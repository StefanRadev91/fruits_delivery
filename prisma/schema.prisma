generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Enums ─────────────

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum CompanyRole {
  OWNER
  ORDERER
}

enum CompanyStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Audience {
  B2B
  B2C
}

enum Unit {
  KG
  PIECE
  BUNCH
  CRATE
  BOX
}

enum Origin {
  BULGARIA
  IMPORT
}

enum StockStatus {
  IN_STOCK
  LOW
  OUT_OF_STOCK
}

enum OrderStatus {
  NEW
  CONFIRMED
  PICKING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  INVOICE
  CASH
  CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

// ───────────── Auth & users ─────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  phone         String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())

  accounts    Account[]
  memberships CompanyMember[]
  addresses   Address[]
  favorites   Favorite[]
  orders      Order[]
}

// Required by the Auth.js Prisma adapter.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Used for magic-link sign-in.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ───────────── Companies (B2B) ─────────────

model PriceList {
  id              String  @id @default(cuid())
  name            String
  /// Percentage discount on the base price, e.g. 10.00
  discountPercent Decimal @default(0) @db.Decimal(5, 2)

  items     PriceListItem[]
  companies Company[]
}

model PriceListItem {
  id          String @id @default(cuid())
  priceListId String
  productId   String
  /// Fixed net unit price (cents), overrides the discount.
  priceCents  Int

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId])
}

model Company {
  id               String        @id @default(cuid())
  name             String
  eik              String        @unique
  vatNumber        String?
  mol              String
  contactName      String
  contactPhone     String
  status           CompanyStatus @default(PENDING)
  rejectionReason  String?
  /// Invoice payment terms in days (7/14/30). Null = no invoice credit, pay on delivery.
  paymentTermsDays Int?
  priceListId      String?
  createdAt        DateTime      @default(now())

  priceList      PriceList?      @relation(fields: [priceListId], references: [id])
  members        CompanyMember[]
  addresses      Address[]
  orders         Order[]
  standingOrders StandingOrder[]
}

model CompanyMember {
  id        String      @id @default(cuid())
  userId    String
  companyId String
  role      CompanyRole @default(ORDERER)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

/// Delivery address: an object of a company, or a saved address of a household user.
model Address {
  id        String  @id @default(cuid())
  companyId String?
  userId    String?
  label     String
  city      String
  postcode  String
  street    String
  notes     String?

  company        Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  standingOrders StandingOrder[]
}

// ───────────── Delivery ─────────────

model DeliveryZone {
  id               String  @id @default(cuid())
  name             String
  active           Boolean @default(true)
  /// 0 = Sunday ... 6 = Saturday
  deliveryWeekdays Int[]
  /// "HH:mm" local (Europe/Sofia)
  cutoffTime       String
  /// Days before delivery the cut-off falls on (1 = next-day delivery)
  leadDays         Int     @default(1)
  b2bMinOrderCents Int     @default(0)
  b2bFeeCents      Int     @default(0)
  b2cMinOrderCents Int     @default(0)
  b2cFeeCents      Int     @default(0)

  postcodes      ZonePostcode[]
  slots          TimeSlot[]
  orders         Order[]
  standingOrders StandingOrder[]
}

model ZonePostcode {
  id       String @id @default(cuid())
  zoneId   String
  city     String
  postcode String @unique

  zone DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
}

model TimeSlot {
  id        String @id @default(cuid())
  zoneId    String
  /// "HH:mm"
  startTime String
  endTime   String

  zone           DeliveryZone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  orders         Order[]
  standingOrders StandingOrder[]
}

// ───────────── Catalog ─────────────

model Category {
  id        String @id @default(cuid())
  name      String
  slug      String @unique
  sortOrder Int    @default(0)

  products Product[]
}

model Product {
  id               String      @id @default(cuid())
  name             String
  slug             String      @unique
  description      String?
  categoryId       String
  unit             Unit
  /// Unknown for some products (null): the badge is simply not shown.
  origin           Origin?
  /// Net price per unit in cents (without VAT).
  basePriceCents   Int
  vatRate          Int         @default(20)
  /// Real weight is entered at picking; the customer sees an estimate.
  variableWeight   Boolean     @default(false)
  minQuantity      Decimal     @default(1) @db.Decimal(10, 3)
  stepQuantity     Decimal     @default(1) @db.Decimal(10, 3)
  stockStatus      StockStatus @default(IN_STOCK)
  /// Season as months 1-12; both null = available all year. May wrap the year end (11 -> 2).
  seasonStartMonth Int?
  seasonEndMonth   Int?
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now())

  category       Category            @relation(fields: [categoryId], references: [id])
  photos         ProductPhoto[]
  priceListItems PriceListItem[]
  favorites      Favorite[]
  orderLines     OrderLine[]
  standingItems  StandingOrderItem[]
}

model ProductPhoto {
  id        String @id @default(cuid())
  productId String
  url       String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

/// "Моята листа" - quick-order list of a user.
model Favorite {
  id        String @id @default(cuid())
  userId    String
  productId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ───────────── Orders ─────────────

model Order {
  id       String      @id @default(cuid())
  /// Human-friendly order number
  number   Int         @unique @default(autoincrement())
  audience Audience
  status   OrderStatus @default(NEW)

  userId        String?
  companyId     String?
  /// For guest checkout (no account)
  guestEmail    String?
  /// Public token for tracking a guest order
  trackingToken String  @unique @default(cuid())

  // Delivery snapshot
  contactName  String
  contactPhone String
  city         String
  postcode     String
  street       String
  notes        String?
  zoneId       String
  deliveryDate DateTime @db.Date
  timeSlotId   String?

  paymentMethod    PaymentMethod
  paymentStatus    PaymentStatus @default(PENDING)
  paymentTermsDays Int?
  deliveryFeeCents Int           @default(0)
  vatRate          Int           @default(20)

  standingOrderId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User?          @relation(fields: [userId], references: [id])
  company       Company?       @relation(fields: [companyId], references: [id])
  zone          DeliveryZone   @relation(fields: [zoneId], references: [id])
  timeSlot      TimeSlot?      @relation(fields: [timeSlotId], references: [id])
  standingOrder StandingOrder? @relation(fields: [standingOrderId], references: [id])
  lines         OrderLine[]
  payments      Payment[]
  invoice       Invoice?

  /// One generated order per standing order and delivery day.
  @@unique([standingOrderId, deliveryDate])
  @@index([deliveryDate, status])
}

model OrderLine {
  id             String   @id @default(cuid())
  orderId        String
  productId      String
  // Snapshots at order time
  productName    String
  unit           Unit
  unitNetCents   Int
  variableWeight Boolean
  quantity       Decimal  @db.Decimal(10, 3)
  /// Real quantity entered at picking
  actualQuantity Decimal? @db.Decimal(10, 3)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  provider    String
  providerRef String?
  amountCents Int
  status      PaymentStatus @default(PENDING)
  createdAt   DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Invoice {
  id       String    @id @default(cuid())
  /// Sequential invoice number
  number   Int       @unique @default(autoincrement())
  orderId  String    @unique
  issuedAt DateTime  @default(now())
  dueDate  DateTime? @db.Date

  // Amounts are frozen when the invoice is issued.
  netCents   Int
  vatCents   Int
  grossCents Int

  // Buyer snapshot
  buyerName      String
  buyerEik       String?
  buyerVatNumber String?
  buyerMol       String?
  buyerAddress   String

  order Order @relation(fields: [orderId], references: [id])
}

// ───────────── Standing orders ─────────────

model StandingOrder {
  id         String    @id @default(cuid())
  companyId  String
  addressId  String
  zoneId     String
  timeSlotId String?
  /// 0 = Sunday ... 6 = Saturday
  weekdays   Int[]
  startDate  DateTime  @db.Date
  endDate    DateTime? @db.Date
  active     Boolean   @default(true)

  company  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  address  Address             @relation(fields: [addressId], references: [id])
  zone     DeliveryZone        @relation(fields: [zoneId], references: [id])
  timeSlot TimeSlot?           @relation(fields: [timeSlotId], references: [id])
  items    StandingOrderItem[]
  skips    StandingOrderSkip[]
  orders   Order[]
}

model StandingOrderItem {
  id              String  @id @default(cuid())
  standingOrderId String
  productId       String
  quantity        Decimal @db.Decimal(10, 3)

  standingOrder StandingOrder @relation(fields: [standingOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
}

model StandingOrderSkip {
  id              String   @id @default(cuid())
  standingOrderId String
  date            DateTime @db.Date

  standingOrder StandingOrder @relation(fields: [standingOrderId], references: [id], onDelete: Cascade)

  @@unique([standingOrderId, date])
}
