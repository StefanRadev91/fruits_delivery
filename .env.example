# Local Docker. On Neon/Vercel: DATABASE_URL = pooled string (host contains -pooler),
# DIRECT_URL = direct string, used only by migrations. Locally DIRECT_URL can stay empty.
DATABASE_URL="postgresql://fruits:fruits@localhost:5432/fruits"
# DIRECT_URL=""
APP_URL="http://localhost:3000"

# Money display: set to "true" to also show BGN (fixed rate 1.95583)
NEXT_PUBLIC_SHOW_BGN="false"

# Household (B2C) ordering. Off = businesses only.
NEXT_PUBLIC_B2C_ENABLED="false"

# Email (Mailpit locally: http://localhost:8025)
SMTP_HOST="localhost"
SMTP_PORT="1025"
EMAIL_FROM="L&S FRESH FRUITS <no-reply@example.com>"

# Secret for the standing-orders cron endpoint
CRON_SECRET="change-me"

# Auth.js (generate with: openssl rand -base64 32)
AUTH_SECRET="change-me"
AUTH_TRUST_HOST="true"
